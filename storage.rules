rules_version = '2';

// Craft rules based on data in your Firestore database
// allow write: if firestore.get(
//    /databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin;
service firebase.storage {
  match /b/{bucket}/o {
    match /children/pfps/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    match /claims/{docType}/{donorId}/{giftId} {
      allow read: if request.auth != null && (
        request.auth.uid == donorId
        || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ["DIRECTOR", "ADMIN", "VOLUNTEER"]
      );
      allow write: if request.auth != null
        && request.auth.uid == donorId
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)|application/pdf')
        && firestore.get(/databases/(default)/documents/gifts/$(giftId)).data.claimedByDonorId == donorId;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
