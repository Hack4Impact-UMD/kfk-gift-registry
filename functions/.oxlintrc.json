{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import"],
  "categories": {
    "correctness": "warn"
  },
  "env": {
    "builtin": true,
    "es2020": true,
    "node": true
  },
  "ignorePatterns": ["/lib/**/*", "/generated/**/*"],
  "rules": {
    "@typescript-eslint/no-explicit-any": "error",
    "import/no-unresolved": "off"
  }
}
