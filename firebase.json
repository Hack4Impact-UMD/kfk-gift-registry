{
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions/isolate",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "firebase-debug.log",
        "firebase-debug.*.log",
        ".runtimeconfig.json"
      ],
      "predeploy": [
        "pnpm run build",
        "isolate",
        "pnpm --dir functions/isolate install --frozen-lockfile"
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules",
    "bucket": "kfk-gift-registry.firebasestorage.app"
  },
  "emulators": {
    "apphosting": {
      "port": 5002,
      "rootDirectory": "./app",
      "startCommand": "pnpm run dev"
    },
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  },
  "apphosting": {
    "backendId": "kfk-gift-registry",
    "rootDir": ".",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
    ],
    "alwaysDeployFromSource": true
  }
}
